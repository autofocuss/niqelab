---
import Base from '../layouts/Base.astro';
import { packages } from '../data/site';
---
<Base title="Packages" description="Three ways to start with NiqeLab: a one-off site, a site with a CMS you can edit yourself, or an ongoing design retainer.">
  <section class="wrap pad--tight">
    <p class="hero__eyebrow">Packages</p>
    <h1 data-split="lines" data-intro class="h2" style="font-size: var(--t-xl);">Pick where <em>you start.</em></h1>
    <p class="lede" data-reveal="up" data-intro data-delay="0.08" style="font-size:1.05rem;">
      Click a package to copy a ready-made enquiry and open your email app.
    </p>
  </section>

  <section class="wrap pad--tight">
    <h2 class="sr-only">Packages</h2>
    <div class="tickets">
      {packages.map((pkg) => (
        <button type="button" class:list={['ticket', pkg.featured && 'ticket--featured']}
          data-package={pkg.name} data-details={pkg.features.join(', ')} data-reveal="up">
          <p class="ticket__tag">{pkg.tag}</p>
          <h3>{pkg.name}</h3>
          <ul>{pkg.features.map((f) => <li>{f}</li>)}</ul>
          <div class="ticket__foot">
            <span>Click to send an enquiry</span>
            <span class="ticket__status">Copied, opening email</span>
          </div>
        </button>
      ))}
    </div>
    <p style="color: var(--c-muted); margin-top:2rem; max-width:36rem; font-size:1rem; line-height:1.6;">
      Not sure which fits? <a href="/niqelab/contact/" class="link">Talk to us directly</a> and we'll scope it together.
    </p>
  </section>

  <section class="wrap pad--tight" style="border-top:1px solid var(--c-line);">
    <div class="pair">
      <div data-reveal="up">
        <p class="mono" style="font-size:0.7rem; letter-spacing:0.06em; text-transform:uppercase; color: var(--c-muted); margin-bottom:0.6rem;">How pricing works</p>
        <p style="font-size:1rem; line-height:1.65; color: var(--c-fg-soft);">Every project is scoped and quoted before any work starts. No hourly billing, no surprise invoices.</p>
      </div>
      <div data-reveal="up" data-delay="0.1">
        <p class="mono" style="font-size:0.7rem; letter-spacing:0.06em; text-transform:uppercase; color: var(--c-muted); margin-bottom:0.6rem;">What's never extra</p>
        <p style="font-size:1rem; line-height:1.65; color: var(--c-fg-soft);">Mobile layout, basic SEO setup and a working contact form come with every package, not as an add-on.</p>
      </div>
    </div>
  </section>
</Base>
