---
import Base from '../layouts/Base.astro';
import { site } from '../data/site';
---
<Base title="Contact" description="Start a project with NiqeLab. Email the team and we'll scope the pages, the timeline and the price.">
  <section class="cta wrap" style="min-height:62svh; display:flex; flex-direction:column; justify-content:center; padding-block: clamp(3rem,6vw,5rem);">
    <p class="mono" style="font-size:0.75rem; letter-spacing:0.08em; text-transform:uppercase; color: rgb(247 244 236 / 0.6);">Start a project</p>
    <h1 data-split="lines" data-intro style="font-size: clamp(2.2rem, 1.4rem + 3.6vw, 3.8rem); color: var(--c-bg); margin-top:0.8rem;">
      Tell us what the site <em style="color: var(--c-pop);">needs to do.</em>
    </h1>
    <p data-reveal="up" data-intro data-delay="0.08" style="color: rgb(247 244 236 / 0.75); margin-top:1.1rem; max-width:34rem; font-size:1.1rem; line-height:1.6;">
      We'll scope the pages, the timeline and the price before anything gets built.
    </p>
    <div style="margin-top:2rem; display:flex; flex-wrap:wrap; gap:1rem; align-items:center;" data-reveal="up" data-intro data-delay="0.16">
      <div class="copybar copybar--dark">
        <span id="contact-email">{site.email}</span>
        <button class="copy-btn" type="button" data-copy-target="contact-email">Copy</button>
      </div>
      <a href={`mailto:${site.email}?cc=${encodeURIComponent(site.ccEmail)}&subject=${encodeURIComponent('NiqeLab project inquiry')}`} class="btn" style="border-color: var(--c-bg); color: var(--c-bg);">Email us &rarr;</a>
    </div>
  </section>

  <section class="wrap pad--tight">
    <div class="section-head" data-reveal="up">
      <h2>Or tell us <em>right here.</em></h2>
      <p>Fill this in and it's sent straight to us — no mail app required.</p>
    </div>
    <form id="contact-form" class="contact-form" data-reveal="up" data-delay="0.08">
      <div class="contact-form__row">
        <label for="cf-name">Your name</label>
        <input id="cf-name" name="name" type="text" required autocomplete="name" />
      </div>
      <div class="contact-form__row">
        <label for="cf-email">Your email</label>
        <input id="cf-email" name="email" type="email" required autocomplete="email" />
      </div>
      <div class="contact-form__row">
        <label for="cf-message">What does the site need to do?</label>
        <textarea id="cf-message" name="message" rows="4" required placeholder="A few pages, a booking form, a redesign of what we have..."></textarea>
      </div>
      <button type="submit" class="btn btn--solid" data-fill data-submit-btn>
        <span class="btn__fill" aria-hidden="true"></span><span data-submit-label>Send &rarr;</span>
      </button>
      <p class="contact-form__status" data-form-status role="status" aria-live="polite"></p>
    </form>
  </section>

  <section class="wrap pad--tight">
    <div class="section-head" data-reveal="up">
      <h2>Or skip the typing <em>entirely.</em></h2>
    </div>
    <div class="contact-options">
      <a class="contact-option contact-option--calendar" data-reveal="up" href={site.calendarUrl} target="_blank" rel="noopener">
        <span class="contact-option__icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
            <rect x="3" y="4.5" width="18" height="16" rx="3"/>
            <path d="M3 9.5h18M8 2.5v4M16 2.5v4"/>
            <path d="M8.5 14.2l2 2 4.5-4.5"/>
          </svg>
        </span>
        <span class="contact-option__body">
          <strong>Book a call</strong>
          <span class="mono">15 minutes, pick a time that works for you.</span>
        </span>
        <span class="contact-option__arrow" aria-hidden="true">&rarr;</span>
      </a>
      <a class="contact-option contact-option--whatsapp" data-reveal="up" data-delay="0.1" href={`https://wa.me/${site.whatsapp}`} target="_blank" rel="noopener">
        <span class="contact-option__icon" aria-hidden="true">
          <svg viewBox="0 0 32 32" width="20" height="20" fill="currentColor"><path d="M16.001 3C9.096 3 3.5 8.597 3.5 15.5c0 2.33.638 4.512 1.746 6.384L3 29l7.32-2.21a12.43 12.43 0 0 0 5.68 1.385C22.905 28.175 28.5 22.58 28.5 15.676 28.5 8.773 22.905 3.176 16.001 3Zm0 22.7a10.08 10.08 0 0 1-5.148-1.41l-.37-.22-3.86 1.166 1.19-3.76-.24-.386a10.1 10.1 0 0 1-1.573-5.39c0-5.59 4.552-10.14 10.15-10.14 5.597 0 10.14 4.55 10.14 10.14 0 5.59-4.55 10.14-10.15 10.14Zm5.564-7.59c-.305-.153-1.804-.89-2.084-.992-.28-.102-.484-.153-.688.153s-.79.99-.968 1.195c-.178.204-.356.23-.661.077-.305-.153-1.287-.474-2.452-1.513-.906-.808-1.518-1.806-1.696-2.111-.178-.306-.019-.47.134-.622.137-.137.305-.356.457-.535.153-.178.204-.306.306-.51.102-.204.051-.383-.026-.536-.077-.153-.688-1.659-.943-2.272-.248-.598-.5-.517-.688-.527l-.586-.01c-.204 0-.535.077-.815.383s-1.068 1.043-1.068 2.545c0 1.502 1.093 2.953 1.246 3.158.153.204 2.15 3.283 5.208 4.603.728.314 1.295.502 1.738.643.73.232 1.394.2 1.92.121.586-.087 1.804-.737 2.058-1.449.254-.712.254-1.322.178-1.45-.076-.127-.28-.204-.585-.357Z"/></svg>
        </span>
        <span class="contact-option__body">
          <strong>WhatsApp us</strong>
          <span class="mono">Fastest — usually a reply in minutes.</span>
        </span>
        <span class="contact-option__arrow" aria-hidden="true">&rarr;</span>
      </a>
    </div>
  </section>
</Base>
