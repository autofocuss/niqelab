---
import Base from '../../layouts/Base.astro';
import { projects } from '../../data/site';
---
<Base title="Work" description="Nine live websites NiqeLab has designed and built, across clinics, D2C, SaaS, manufacturing and travel.">
  <section class="wrap pad--tight">
    <p class="hero__eyebrow">Selected work</p>
    <h1 data-split="lines" data-intro class="h2" style="font-size: var(--t-xl);">Real sites, <em>not renders.</em></h1>
    <p class="lede" data-reveal="up" data-intro data-delay="0.08" style="font-size:1.05rem;">
      Nine live projects. Click any row to visit the site, or open the case notes.
    </p>
  </section>

  <section class="wrap pad--tight">
    <div class="index-list">
      {projects.map((p, i) => (
        <div class="index-row-wrap" data-focus>
          <div style="display:flex; align-items:center; gap:1.2rem; padding:1.3rem 0; border-bottom:1px solid var(--c-line);">
            <span class="mono" style="color: var(--c-muted); font-size:0.75rem; min-width:1.6rem;">{String(i + 1).padStart(2, '0')}</span>
            <a href={`/niqelab/work/${p.slug}/`} class="index-row__thumb" data-cursor="View">
              <img src={p.image} alt={`${p.title} website`} width="800" height="600" loading="lazy" />
            </a>
            <a href={`/niqelab/work/${p.slug}/`} style="flex:1; min-width:0;" class="roll">
              <span style="display:block;">
                <span class="index-row__title" style="display:block;">{p.title}</span>
                <span class="mono" style="font-size:0.75rem; color: var(--c-muted);">{p.kind} &middot; {p.domain}</span>
              </span>
              <span aria-hidden="true" style="display:block;">
                <span class="index-row__title" style="display:block;">{p.title}</span>
                <span class="mono" style="font-size:0.75rem; color: var(--c-muted);">{p.kind} &middot; {p.domain}</span>
              </span>
            </a>
            <a href={p.url} target="_blank" rel="noopener" class="mono" style="font-size:0.75rem; color: var(--c-accent-deep); padding:0.5rem 0.3rem; display:inline-flex; align-items:center;" data-cursor="Visit">Visit &rarr;</a>
          </div>
        </div>
      ))}
    </div>
  </section>

  <section class="cta pad wrap">
    <h2 data-split="lines">Want your site to look like <em style="color: var(--c-pop);">one of these?</em></h2>
    <div style="margin-top:1.6rem; display:flex; gap:1rem; flex-wrap:wrap;">
      <a href="/niqelab/contact/" class="btn btn--solid" data-fill data-magnetic="0.2"><span class="btn__fill" aria-hidden="true"></span>Start a project</a>
      <a href="/niqelab/packages/" class="btn" style="border-color: var(--c-bg); color: var(--c-bg);">See packages</a>
    </div>
  </section>
</Base>
