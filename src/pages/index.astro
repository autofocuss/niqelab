---
import Base from '../layouts/Base.astro';
import NotificationStack from '../components/NotificationStack.astro';
import { projects, packages } from '../data/site';
import { posts } from '../data/blog';
const featured = projects.slice(0, 3);
---
<Base description="NiqeLab designs and builds websites that turn visitors into enquiries, bookings and calls. See real work, real packages, and start a project.">
  <section class="wrap hero">
    <div class="hero__grid">
      <div>
        <p class="hero__eyebrow">Website design and build studio</p>
        <h1 data-split="lines" data-intro>Your website is losing you <em>customers.</em></h1>
        <p class="lede" data-reveal="up" data-intro data-delay="0.1">
          Most small business sites are slow, unclear or years out of date. We design and build
          the kind of site that turns a visitor into an enquiry, a booking or a call.
        </p>
        <div class="hero__actions" data-reveal="up" data-intro data-delay="0.18">
          <a href="/niqelab/contact/" class="btn btn--solid" data-fill data-magnetic="0.2">
            <span class="btn__fill" aria-hidden="true"></span>Start a project
          </a>
          <a href="/niqelab/work/" class="btn btn--ghost">See our work</a>
        </div>
      </div>
      <NotificationStack />
    </div>
  </section>

  <section class="wrap pad">
    <div class="section-head">
      <h2 data-split="lines">What you get, <em>and what we don't do.</em></h2>
    </div>
    <div class="pair" style="margin-top: 2.5rem;">
      <div class="panel panel--dark" data-reveal="up">
        <p class="mono" style="font-size:0.7rem; letter-spacing:0.06em; text-transform:uppercase; color: var(--c-pop); margin-bottom:0.8rem;">What you get</p>
        <ul>
          <li>A site designed around one goal: more enquiries</li>
          <li>Usually live within weeks, not quarters</li>
          <li>Yours to keep. No lock-in, no platform fee</li>
        </ul>
      </div>
      <div class="panel panel--light" data-reveal="up" data-delay="0.1">
        <p class="mono" style="font-size:0.7rem; letter-spacing:0.06em; text-transform:uppercase; color: var(--c-muted); margin-bottom:0.8rem;">What we don't do</p>
        <ul>
          <li>We don't run your ads or your social media</li>
          <li>We don't ship a template with your logo swapped in</li>
          <li>We don't disappear after launch. Every project gets support</li>
        </ul>
      </div>
    </div>
  </section>

  <section class="wrap pad">
    <div class="section-head">
      <h2 data-split="lines">Real sites, <em>not renders.</em></h2>
      <p>Nine live projects, each built around what that business actually needed.</p>
    </div>
    <div class="work-grid">
      {featured.map((p) => (
        <a class="tile" href={p.url} target="_blank" rel="noopener" style={`--tint:${p.tint}; --accent:${p.accent}`} data-focus data-cursor="Visit">
          <div class="tile__chrome"><span class="tile__dot"></span><span class="tile__url">{p.domain}</span></div>
          <div class="tile__shot"><div class="tile__shot-inner"><img src={p.image} alt={`${p.title} website, home page`} width="800" height="600" loading="lazy" /></div></div>
          <div class="tile__meta">
            <div><h3>{p.title}</h3><p class="tile__kind">{p.kind}</p></div>
            <span class="tile__arrow">Visit &rarr;</span>
          </div>
        </a>
      ))}
    </div>
    <div style="text-align:center; margin-top:2.2rem;">
      <a href="/niqelab/work/" class="btn btn--ghost">See all 9 projects</a>
    </div>
  </section>

  <section class="proc pad">
    <div class="wrap">
      <div class="section-head">
        <h2 data-split="lines">How a site <em>gets built.</em></h2>
      </div>
      <div class="proc-grid">
        <div class="proc-card" data-reveal="up">
          <span class="proc-num">01</span>
          <h3>Discovery</h3>
          <p>What the site has to do, for whom, and what it's replacing.</p>
        </div>
        <div class="proc-card" data-reveal="up" data-delay="0.08">
          <span class="proc-num">02</span>
          <h3>Design</h3>
          <p>A look built for your business, not a template with your name on it.</p>
        </div>
        <div class="proc-card" data-reveal="up" data-delay="0.16">
          <span class="proc-num">03</span>
          <h3>Build</h3>
          <p>Responsive, fast, and checked on real phones before it ships.</p>
        </div>
        <div class="proc-card" data-reveal="up" data-delay="0.24">
          <span class="proc-num">04</span>
          <h3>Launch</h3>
          <p>Live, handed off clean, with support after.</p>
        </div>
      </div>
    </div>
  </section>

  <div class="ribbon">
    <div class="ribbon__track mono" aria-hidden="true">
      {Array.from({ length: 2 }).map(() => (
        <>
          <span>MORE ENQUIRIES</span><span>&#10022;</span>
          <span>MORE BOOKINGS</span><span>&#10022;</span>
          <span>MORE CALLS</span><span>&#10022;</span>
          <span>ONE SITE THAT WORKS</span><span>&#10022;</span>
        </>
      ))}
    </div>
  </div>

  <section class="wrap pad">
    <div class="section-head">
      <h2 data-split="lines">Pick where <em>you start.</em></h2>
      <p>Click a package to send us a ready-made enquiry.</p>
    </div>
    <div class="tickets">
      {packages.map((pkg) => (
        <button type="button" class:list={['ticket', pkg.featured && 'ticket--featured']}
          data-package={pkg.name} data-details={pkg.features.join(', ')} data-reveal="up">
          <p class="ticket__tag">{pkg.tag}</p>
          <h3>{pkg.name}</h3>
          <ul>{pkg.features.map((f) => <li>{f}</li>)}</ul>
          <div class="ticket__foot">
            <span>Click to send an enquiry</span>
            <span class="ticket__status">Copied, opening email</span>
          </div>
        </button>
      ))}
    </div>
    <div style="text-align:center; margin-top:2rem;">
      <a href="/niqelab/packages/" class="btn btn--ghost">See full package details</a>
    </div>
  </section>

  <section class="wrap pad" style="background: var(--c-bg-dim);">
    <div class="section-head">
      <h2 data-split="lines">Notes on <em>building websites.</em></h2>
    </div>
    <div class="post-grid">
      {posts.map((post) => (
        <a class="post-card" href={`/niqelab/blog/${post.slug}/`} data-reveal="up">
          <span class="post-card__tag">{post.tag} &middot; {post.readTime}</span>
          <h3>{post.title}</h3>
          <p>{post.dek}</p>
        </a>
      ))}
    </div>
  </section>

  <section class="cta pad wrap">
    <h2 data-split="lines">Tell us what your site <em style="color: var(--c-pop);">needs to do.</em></h2>
    <p style="color: rgb(247 244 236 / 0.7); margin-top:1rem; max-width:34rem; font-size:1.05rem; line-height:1.6;">
      We'll scope the pages, the timeline and the price before anything gets built.
    </p>
    <div style="margin-top:1.8rem;">
      <a href="/niqelab/contact/" class="btn btn--solid" data-fill data-magnetic="0.2">
        <span class="btn__fill" aria-hidden="true"></span>Get in touch
      </a>
    </div>
  </section>
</Base>
