---
import Base from '../../layouts/Base.astro';
import { posts } from '../../data/blog';

export function getStaticPaths() {
  return posts.map((post, i) => ({
    params: { slug: post.slug },
    props: { post, others: posts.filter((_, j) => j !== i).slice(0, 2) },
  }));
}

const { post, others } = Astro.props;
---
<Base title={post.title} description={post.dek}>
  <section class="wrap pad--tight">
    <article class="article">
      <a href="/niqelab/blog/" class="mono link" style="font-size:0.75rem; display:inline-flex; align-items:center; padding:0.4rem 0.2rem; margin: -0.4rem 0 -0.4rem -0.2rem;">&larr; Back to the blog</a>
      <p class="post-card__tag" style="margin-top:1rem;">{post.tag} &middot; {post.readTime}</p>
      <h1 data-split="lines" data-intro>{post.title}</h1>
      <p class="dek">{post.dek}</p>
      {post.body.map((block) => (
        block.h ? <h2>{block.h}</h2> :
        block.ul ? <ul>{block.ul.map((item) => <li>{item}</li>)}</ul> :
        <p>{block.p}</p>
      ))}
    </article>
  </section>

  <section class="wrap pad--tight" style="background: var(--c-bg-dim); border-radius: var(--radius);">
    <p class="mono" style="font-size:0.7rem; letter-spacing:0.06em; text-transform:uppercase; color: var(--c-muted); margin-bottom:1rem;">More from the blog</p>
    <div class="post-grid" style="grid-template-columns: repeat(2, 1fr);">
      {others.map((o) => (
        <a class="post-card" href={`/niqelab/blog/${o.slug}/`} data-reveal="up">
          <span class="post-card__tag">{o.tag} &middot; {o.readTime}</span>
          <h3>{o.title}</h3>
          <p>{o.dek}</p>
        </a>
      ))}
    </div>
  </section>
</Base>
