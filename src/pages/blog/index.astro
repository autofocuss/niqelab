---
import Base from '../../layouts/Base.astro';
import { posts } from '../../data/blog';
---
<Base title="Blog" description="Short, specific posts on the decisions that separate a website that works from one that just exists.">
  <section class="wrap pad--tight">
    <p class="hero__eyebrow">The blog</p>
    <h1 data-split="lines" data-intro class="h2" style="font-size: var(--t-xl);">Notes on <em>building websites.</em></h1>
  </section>

  <section class="wrap pad--tight">
    <h2 class="sr-only">All posts</h2>
    <div class="post-grid">
      {posts.map((post) => (
        <a class="post-card" href={`/niqelab/blog/${post.slug}/`} data-reveal="up">
          <div class="post-card__cover" style={`background:${post.cover.tint}`} aria-hidden="true">
            <svg viewBox="0 0 100 100" width="46" height="46" style={`color:${post.cover.accent}`}>
              <path id={`cov-${post.slug}`} d="M50,50 C38,46 32,28 42,10 C46,4 54,4 58,10 C68,28 62,46 50,50 Z" fill="currentColor"/>
              <use href={`#cov-${post.slug}`} fill="currentColor" transform="rotate(60 50 50)"/>
              <use href={`#cov-${post.slug}`} fill="currentColor" transform="rotate(120 50 50)"/>
              <use href={`#cov-${post.slug}`} fill="currentColor" transform="rotate(180 50 50)"/>
              <use href={`#cov-${post.slug}`} fill="currentColor" transform="rotate(240 50 50)"/>
              <use href={`#cov-${post.slug}`} fill="currentColor" transform="rotate(300 50 50)"/>
              <circle cx="50" cy="50" r="11" fill={post.cover.tint}/>
            </svg>
          </div>
          <span class="post-card__tag">{post.tag} &middot; {post.readTime}</span>
          <h3>{post.title}</h3>
          <p>{post.dek}</p>
        </a>
      ))}
    </div>
  </section>
</Base>
