---
import Base from '../layouts/Base.astro';
---
<Base title="Page not found" description="This page could not be found.">
  <section class="wrap notfound">
    <p class="hero__eyebrow">404</p>
    <h1 style="font-family: var(--f-display); font-size: var(--t-xl); font-weight:700;">
      This page never found its <em>focus.</em>
    </h1>
    <a href="/niqelab/" class="btn btn--solid pull-focus" data-fill data-magnetic="0.2">
      <span class="btn__fill" aria-hidden="true"></span>Pull focus, back to home
    </a>
  </section>
</Base>
