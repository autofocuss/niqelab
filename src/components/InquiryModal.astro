---
// Opens from any [data-package] click (see motion/inquiry.ts). The entrance
// is the same aperture-iris the page transitions use (DESIGN.md), opening
// from the exact point you clicked -- the quirky, on-brand touch the client
// asked for, instead of a generic fade-in dialog.
import { site } from '../data/site';
---
<div id="inquiry-modal" class="inquiry-modal" aria-hidden="true">
  <div class="inquiry-modal__backdrop" data-modal-close></div>
  <div class="inquiry-modal__panel" role="dialog" aria-modal="true" aria-labelledby="inquiry-modal-title" tabindex="-1">
    <button type="button" class="inquiry-modal__close" data-modal-close aria-label="Close">
      <svg viewBox="0 0 100 100" width="26" height="26" aria-hidden="true">
        <path id="modal-blade" d="M50,50 C38,46 32,28 42,10 C46,4 54,4 58,10 C68,28 62,46 50,50 Z" fill="#FF5A3C"/>
        <use href="#modal-blade" fill="#5A35C9" transform="rotate(60 50 50)"/>
        <use href="#modal-blade" fill="#FF5A3C" transform="rotate(120 50 50)"/>
        <use href="#modal-blade" fill="#5A35C9" transform="rotate(180 50 50)"/>
        <use href="#modal-blade" fill="#FF5A3C" transform="rotate(240 50 50)"/>
        <use href="#modal-blade" fill="#5A35C9" transform="rotate(300 50 50)"/>
        <circle cx="50" cy="50" r="11" fill="#F7F4EC"/>
      </svg>
    </button>

    <p class="inquiry-modal__eyebrow mono">Starting with</p>
    <h2 id="inquiry-modal-title" class="inquiry-modal__title" data-modal-package>One-Off Site</h2>
    <p class="inquiry-modal__dek">However you'd rather talk. Both reach the same humans.</p>

    <a
      class="inquiry-modal__whatsapp"
      data-modal-whatsapp
      href={`https://wa.me/${site.whatsapp}`}
      target="_blank"
      rel="noopener"
    >
      <span class="inquiry-modal__whatsapp-icon" aria-hidden="true">
        <svg viewBox="0 0 32 32" width="22" height="22" fill="currentColor"><path d="M16.001 3C9.096 3 3.5 8.597 3.5 15.5c0 2.33.638 4.512 1.746 6.384L3 29l7.32-2.21a12.43 12.43 0 0 0 5.68 1.385C22.905 28.175 28.5 22.58 28.5 15.676 28.5 8.773 22.905 3.176 16.001 3Zm0 22.7a10.08 10.08 0 0 1-5.148-1.41l-.37-.22-3.86 1.166 1.19-3.76-.24-.386a10.1 10.1 0 0 1-1.573-5.39c0-5.59 4.552-10.14 10.15-10.14 5.597 0 10.14 4.55 10.14 10.14 0 5.59-4.55 10.14-10.15 10.14Zm5.564-7.59c-.305-.153-1.804-.89-2.084-.992-.28-.102-.484-.153-.688.153s-.79.99-.968 1.195c-.178.204-.356.23-.661.077-.305-.153-1.287-.474-2.452-1.513-.906-.808-1.518-1.806-1.696-2.111-.178-.306-.019-.47.134-.622.137-.137.305-.356.457-.535.153-.178.204-.306.306-.51.102-.204.051-.383-.026-.536-.077-.153-.688-1.659-.943-2.272-.248-.598-.5-.517-.688-.527l-.586-.01c-.204 0-.535.077-.815.383s-1.068 1.043-1.068 2.545c0 1.502 1.093 2.953 1.246 3.158.153.204 2.15 3.283 5.208 4.603.728.314 1.295.502 1.738.643.73.232 1.394.2 1.92.121.586-.087 1.804-.737 2.058-1.449.254-.712.254-1.322.178-1.45-.076-.127-.28-.204-.585-.357Z"/></svg>
      </span>
      <span>
        <strong>Just WhatsApp us</strong>
        <span class="mono">Fastest. Usually a reply in minutes.</span>
      </span>
      <span class="inquiry-modal__whatsapp-arrow" aria-hidden="true">&rarr;</span>
    </a>

    <div class="inquiry-modal__divider"><span>or, if you'd rather type it out</span></div>

    <form id="inquiry-form" class="contact-form contact-form--modal">
      <div class="contact-form__row">
        <label for="im-name">Your name</label>
        <input id="im-name" name="name" type="text" required autocomplete="name" />
      </div>
      <div class="contact-form__row">
        <label for="im-email">Your email</label>
        <input id="im-email" name="email" type="email" required autocomplete="email" />
      </div>
      <div class="contact-form__row">
        <label for="im-message">A bit about your project</label>
        <textarea id="im-message" name="message" rows="3" placeholder="Pages, timeline, anything you already know"></textarea>
      </div>
      <button type="submit" class="btn btn--solid" data-fill data-submit-btn>
        <span class="btn__fill" aria-hidden="true"></span><span data-submit-label>Send it in &rarr;</span>
      </button>
      <p class="contact-form__status" data-form-status role="status" aria-live="polite"></p>
    </form>
  </div>
</div>
