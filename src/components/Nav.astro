---
import { site } from '../data/site';
const path = Astro.url.pathname;
const base = import.meta.env.BASE_URL.replace(/\/$/, ''); // e.g. "/niqelab", "" in dev
const links = [
  { href: `${base}/`, label: 'Home' },
  { href: `${base}/work/`, label: 'Work' },
  { href: `${base}/packages/`, label: 'Packages' },
  { href: `${base}/blog/`, label: 'Blog' },
  { href: `${base}/about/`, label: 'About' },
];
const isActive = (href: string) => (href === `${base}/` ? path === href : path.startsWith(href));
---
<header class="nav">
  <a href="/niqelab/" class="nav__brand" aria-label={`${site.name}, home`}>
    <svg viewBox="0 0 100 100" width="22" height="22" aria-hidden="true">
      <path id="nav-blade" d="M50,50 C38,46 32,28 42,10 C46,4 54,4 58,10 C68,28 62,46 50,50 Z" fill="#FF5A3C"/>
      <use href="#nav-blade" fill="#4F46FF" transform="rotate(60 50 50)"/>
      <use href="#nav-blade" fill="#FF5A3C" transform="rotate(120 50 50)"/>
      <use href="#nav-blade" fill="#4F46FF" transform="rotate(180 50 50)"/>
      <use href="#nav-blade" fill="#FF5A3C" transform="rotate(240 50 50)"/>
      <use href="#nav-blade" fill="#4F46FF" transform="rotate(300 50 50)"/>
      <circle cx="50" cy="50" r="11" fill="#F7F4EC"/>
    </svg>
    <span>niqelab</span>
  </a>
  <nav class="nav__links" aria-label="Primary">
    {links.map((l) => (
      <a href={l.href} class="nav-link" aria-current={isActive(l.href) ? 'page' : undefined}>
        <span class="roll"><span>{l.label}</span><span aria-hidden="true">{l.label}</span></span>
      </a>
    ))}
  </nav>
  <a href="/niqelab/contact/" class="btn btn--solid" data-fill data-magnetic="0.25">
    <span class="btn__fill" aria-hidden="true"></span>Start a project
  </a>
  <button class="nav__menu-btn" type="button" aria-expanded="false" aria-controls="nav-overlay" data-menu-toggle>
    Menu
  </button>
</header>

<div id="nav-overlay" class="nav-overlay" data-menu-overlay>
  <nav aria-label="Mobile">
    {links.map((l) => (
      <a href={l.href} aria-current={isActive(l.href) ? 'page' : undefined}>{l.label}</a>
    ))}
    <a href="/niqelab/contact/" class="nav-overlay__cta">Start a project</a>
  </nav>
</div>

<script>
  import { onPage } from '../engine';
  onPage(() => {
    const btn = document.querySelector<HTMLButtonElement>('[data-menu-toggle]');
    const overlay = document.querySelector<HTMLElement>('[data-menu-overlay]');
    if (!btn || !overlay) return;
    const close = () => { btn.setAttribute('aria-expanded', 'false'); overlay.classList.remove('is-open'); };
    const open = () => { btn.setAttribute('aria-expanded', 'true'); overlay.classList.add('is-open'); };
    const toggle = () => (btn.getAttribute('aria-expanded') === 'true' ? close() : open());
    btn.addEventListener('click', toggle);
    overlay.querySelectorAll('a').forEach((a) => a.addEventListener('click', close));
    const onKey = (e: KeyboardEvent) => { if (e.key === 'Escape') close(); };
    document.addEventListener('keydown', onKey);
    return () => { btn.removeEventListener('click', toggle); document.removeEventListener('keydown', onKey); };
  });
</script>
