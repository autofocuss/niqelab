---
import { site } from '../data/site';
const year = new Date().getFullYear();
---
<footer class="footer">
  <div class="footer__top">
    <div style="max-width:26rem;">
      <a href="/niqelab/" class="nav__brand" aria-label={`${site.name}, home`} style="color: var(--c-bg);">
        <svg viewBox="0 0 100 100" width="22" height="22" aria-hidden="true">
          <path id="footer-blade" d="M50,50 C38,46 32,28 42,10 C46,4 54,4 58,10 C68,28 62,46 50,50 Z" fill="#FF5A3C"/>
          <use href="#footer-blade" fill="#4F46FF" transform="rotate(60 50 50)"/>
          <use href="#footer-blade" fill="#FF5A3C" transform="rotate(120 50 50)"/>
          <use href="#footer-blade" fill="#4F46FF" transform="rotate(180 50 50)"/>
          <use href="#footer-blade" fill="#FF5A3C" transform="rotate(240 50 50)"/>
          <use href="#footer-blade" fill="#4F46FF" transform="rotate(300 50 50)"/>
          <circle cx="50" cy="50" r="11" fill="#0E0E13"/>
        </svg>
        <span>niqelab</span>
      </a>
      <p class="footer__lede" style="margin-top:1.2rem;">
        A studio that designs and builds websites. One craft, one team, every project.
      </p>
    </div>

    <div>
      <p class="footer__col-label">Site</p>
      <nav class="footer__links" aria-label="Footer">
        <a href="/niqelab/work/">Work</a>
        <a href="/niqelab/packages/">Packages</a>
        <a href="/niqelab/blog/">Blog</a>
        <a href="/niqelab/about/">About</a>
      </nav>
    </div>

    <div>
      <p class="footer__col-label">Get in touch</p>
      <div class="footer__links">
        <a class="link" href={`mailto:${site.email}`}>{site.email}</a>
        <span>{site.location}</span>
      </div>
    </div>
  </div>

  <div class="footer__mark" aria-hidden="true">niqelab</div>

  <div class="footer__bottom">
    <nav aria-label="Footer, repeated">
      <a href="/niqelab/work/">Work</a>
      <a href="/niqelab/packages/">Packages</a>
      <a href="/niqelab/blog/">Blog</a>
      <a href="/niqelab/about/">About</a>
    </nav>
    <span>&copy; {year} niqelab</span>
  </div>
</footer>
