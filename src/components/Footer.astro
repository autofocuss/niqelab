---
import { site } from '../data/site';
const year = new Date().getFullYear();
---
<footer class="footer">
  <div class="footer__top">
    <a href="/niqelab/contact/" class="footer__cta roll">
      <span>Start a project</span><span aria-hidden="true">Start a project</span>
    </a>
    <a class="link" href={`mailto:${site.email}`}>{site.email}</a>
  </div>
  <div class="footer__mark" aria-hidden="true">niqelab</div>
  <div class="footer__bottom">
    <nav aria-label="Footer">
      <a href="/niqelab/work/">Work</a>
      <a href="/niqelab/packages/">Packages</a>
      <a href="/niqelab/blog/">Blog</a>
      <a href="/niqelab/about/">About</a>
    </nav>
    <span class="mono">{site.location} &middot; &copy; {year}</span>
  </div>
</footer>
