---
import { site } from '../data/site';
---
<div id="loader" role="status" aria-label="Loading">
  <div class="loader__mark" aria-hidden="true">
    <svg viewBox="0 0 100 100" width="48" height="48">
      <path id="loader-blade" d="M50,50 C38,46 32,28 42,10 C46,4 54,4 58,10 C68,28 62,46 50,50 Z" fill="#FF5A3C" opacity="0" data-loader-petal />
      <use href="#loader-blade" fill="#4F46FF" transform="rotate(60 50 50)" opacity="0" data-loader-petal />
      <use href="#loader-blade" fill="#FF5A3C" transform="rotate(120 50 50)" opacity="0" data-loader-petal />
      <use href="#loader-blade" fill="#4F46FF" transform="rotate(180 50 50)" opacity="0" data-loader-petal />
      <use href="#loader-blade" fill="#FF5A3C" transform="rotate(240 50 50)" opacity="0" data-loader-petal />
      <use href="#loader-blade" fill="#4F46FF" transform="rotate(300 50 50)" opacity="0" data-loader-petal />
      <circle cx="50" cy="50" r="11" fill="#0E0E13" />
    </svg>
  </div>
  <div class="loader__inner">
    <span class="loader__name" data-loader-out>{site.name}</span>
    <span class="loader__count" data-loader-out data-loader-count>000</span>
  </div>
  <div class="loader__bar" data-loader-bar></div>
</div>
