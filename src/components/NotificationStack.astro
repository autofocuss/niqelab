---
// Illustrative, not a real dashboard: these are examples of what a good site produces,
// the same honest-device technique brandeddoctor.com uses (see DESIGN.md addendum).
import { notifications } from '../data/site';
const icons: Record<string, string> = {
  'Website form': 'W',
  WhatsApp: 'WA',
  Bookings: '✓',
  Search: 'S',
  Analytics: 'A',
};
---
<div class="phone" data-reveal="scale" data-intro>
  <div class="phone__frame">
    <div class="phone__notch"></div>
    <div class="phone__clock">
      <span class="phone__time">9:41</span>
      <span class="phone__day mono">Today</span>
    </div>
    <div class="phone__stack">
      {notifications.map((n, i) => (
        <div class="notice" data-reveal="up" data-intro data-delay={0.16 + i * 0.05}>
          <span class="notice__icon mono" aria-hidden="true">{icons[n.app] ?? n.app[0]}</span>
          <div class="notice__body">
            <div class="notice__row">
              <span class="notice__app mono">{n.app.toUpperCase()}</span>
              <span class="notice__time mono">{n.time}</span>
            </div>
            <p class="notice__lead">{n.lead}</p>
            <p class="notice__text">{n.body}</p>
          </div>
        </div>
      ))}
    </div>
  </div>
</div>
