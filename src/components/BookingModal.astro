---
// Opens from the "Book a call" card on the contact page (motion/booking.ts).
// Same aperture-iris entrance as InquiryModal -- the calendar itself loads in
// an iframe inside our own chrome, so the booking stays on-site instead of
// sending people off to calendar.google.com.
import { site } from '../data/site';
---
<div id="booking-modal" class="inquiry-modal booking-modal" aria-hidden="true">
  <div class="inquiry-modal__backdrop" data-booking-close></div>
  <div class="inquiry-modal__panel booking-modal__panel" role="dialog" aria-modal="true" aria-labelledby="booking-modal-title" tabindex="-1">
    <button type="button" class="inquiry-modal__close" data-booking-close aria-label="Close">
      <svg viewBox="0 0 100 100" width="26" height="26" aria-hidden="true">
        <path id="booking-blade" d="M50,50 C38,46 32,28 42,10 C46,4 54,4 58,10 C68,28 62,46 50,50 Z" fill="#FF5A3C"/>
        <use href="#booking-blade" fill="#5A35C9" transform="rotate(60 50 50)"/>
        <use href="#booking-blade" fill="#FF5A3C" transform="rotate(120 50 50)"/>
        <use href="#booking-blade" fill="#5A35C9" transform="rotate(180 50 50)"/>
        <use href="#booking-blade" fill="#FF5A3C" transform="rotate(240 50 50)"/>
        <use href="#booking-blade" fill="#5A35C9" transform="rotate(300 50 50)"/>
        <circle cx="50" cy="50" r="11" fill="#F7F4EC"/>
      </svg>
    </button>

    <p class="inquiry-modal__eyebrow mono">Pick a time</p>
    <h2 id="booking-modal-title" class="inquiry-modal__title">Book a call</h2>

    <div class="booking-modal__frame-wrap">
      <iframe
        class="booking-modal__frame"
        data-booking-frame
        title="Book a call with NiqeLab"
        src=""
        data-src={site.calendarEmbedUrl}
        loading="lazy"
        frameborder="0"
      ></iframe>
    </div>
  </div>
</div>
