---
// Reused every 2nd/3rd section on /99-website/ and on the homepage. This
// product is strictly pay-first: no inquiry modal, no WhatsApp pre-payment
// contact path. People pay, then we reach out -- never the other way
// around. Until Stripe is wired up (stripe99Url or stripe99PriceId in
// site.ts), the button is disabled rather than offering any contact
// fallback. No code changes needed when Stripe activates.
import { site } from '../data/site';
interface Props {
  ghost?: boolean;
}
const { ghost = false } = Astro.props;
const cls = `btn ${ghost ? 'btn--ghost' : 'btn--solid'}`;
const hasPaymentLink = Boolean(site.stripe99Url);
const hasPriceId = Boolean(site.stripe99PriceId) && Boolean(site.stripePublishableKey);
const successUrl = new URL('99-website/?paid=1', site.url).href;
const cancelUrl = new URL('99-website/?canceled=1', site.url).href;
---
{hasPaymentLink ? (
  <a href={site.stripe99Url} target="_blank" rel="noopener" class={cls} data-fill data-magnetic="0.2">
    <span class="btn__fill" aria-hidden="true" />Buy now — $99 &rarr;
  </a>
) : hasPriceId ? (
  <button
    type="button"
    class={cls}
    data-fill
    data-magnetic="0.2"
    data-stripe-checkout
    data-price-id={site.stripe99PriceId}
    data-pubkey={site.stripePublishableKey}
    data-success-url={successUrl}
    data-cancel-url={cancelUrl}
  >
    <span class="btn__fill" aria-hidden="true" /><span data-stripe-label>Buy now — $99 &rarr;</span>
  </button>
) : (
  <button type="button" class={cls} disabled style="opacity:0.55; cursor:not-allowed;">
    Checkout opening soon
  </button>
)}
